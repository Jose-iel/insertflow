{
  "name": "@insertflow/lib",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./template-types": {
      "types": "./dist/template-types.d.ts",
      "import": "./dist/template-types.js",
      "require": "./dist/template-types.js",
      "default": "./dist/template-types.js"
    }
  },
  "typesVersions": {
    "*": {
      "template-types": ["./dist/template-types.d.ts"]
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "pino": "^8.18.0",
    "pino-pretty": "^10.3.1",
    "ioredis": "^5.3.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@insertflow/config": "*",
    "@types/node": "^20",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8",
    "typescript": "^5"
  }
}
