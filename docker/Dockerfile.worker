# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Install build dependencies for node-canvas
RUN apk add --no-cache \
    openssl \
    python3 \
    make \
    g++ \
    cairo-dev \
    jpeg-dev \
    pango-dev \
    giflib-dev \
    pixman-dev

# Copy all source code (needed for npm workspaces to work correctly)
COPY . .

# Install ALL dependencies
RUN npm ci

# Generate Prisma Client
RUN npm run db:generate

# Build packages and worker
RUN cd packages/database && npm run build
RUN cd packages/lib && npm run build
RUN cd apps/workers && npm run build

# Production stage
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# Install runtime dependencies for node-canvas
RUN apk add --no-cache \
    openssl \
    cairo \
    jpeg \
    pango \
    giflib \
    pixman \
    ttf-freefont \
    ttf-dejavu \
    ttf-liberation \
    fontconfig

# Copy built app and compiled packages (dist only, no src)
COPY --from=builder /app/apps/workers/dist ./apps/workers/dist
COPY --from=builder /app/apps/workers/package.json ./apps/workers/
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/database/dist ./packages/database/dist
COPY --from=builder /app/packages/database/package.json ./packages/database/
COPY --from=builder /app/packages/database/prisma ./packages/database/prisma
COPY --from=builder /app/packages/lib/dist ./packages/lib/dist
COPY --from=builder /app/packages/lib/package.json ./packages/lib/
COPY --from=builder /app/package.json ./

# Create uploads directory
RUN mkdir -p /app/uploads

CMD ["node", "apps/workers/dist/index.js"]
